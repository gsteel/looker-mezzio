{
    "name": "gsteel/looker-mezzio",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "george@net-glue.co.uk"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.4.99"
        }
    },
    "require": {
        "php": "~8.4 || ~8.5",
        "gsteel/looker": "^0",
        "laminas/laminas-servicemanager": "^3.23.0 || ^4.0",
        "mezzio/mezzio-helpers": "^5.15",
        "mezzio/mezzio-template": "^3.0",
        "php-standard-library/type": "^6.1",
        "php-standard-library/vec": "^6.1",
        "psr/container": "^1.1.2 || ^2.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0.0",
        "laminas/laminas-config-aggregator": "^1.19.0",
        "php-standard-library/psalm-plugin": "^2.4",
        "phpunit/phpunit": "^13.1.13",
        "psalm/plugin-phpunit": "^0.20.1",
        "squizlabs/php_codesniffer": "^4.0.1",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Looker\\Mezzio\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Mezzio\\Test\\": "test"
        }
    }
}
